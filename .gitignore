# ── Локальное окружение и редакторы ──
.claude
.vscode/
.idea/
*.swp
*~
CLAUDE.md

# ── Мусор ОС ──
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store

# ── Генератор бренда: исходные шрифты и его выхлоп ──
# Готовые фавиконки и og-image лежат в корне, tools/out — рабочая копия.
tools/fonts/
tools/out/

# ── Артефакты Python (tools/make_brand.py) ──
__pycache__/
*.py[cod]
.venv/
venv/

# ── Node, если появится тулинг ──
node_modules/

# ── Личные документы ──
# В резюме личный телефон, а сайт его не публикует. Это касается любого
# редактируемого формата, не только PDF: .docx точно так же уедет в репозиторий.
# Если захочешь отдавать файл со страницы — git add -f нужный файл.
*.pdf
*.doc
*.docx
*.odt
*.rtf

# ── Внутренние документы ──
# Каталог ведётся локально целиком: журнал работы, разборы и аудиты содержат
# проектные детали заказчика, которым на публичной странице места нет.
docs/

# ── Черновики, замеры, бэкапы ──
# Измерительные страницы кладутся в корень рядом с index.html — под этот
# префикс, чтобы не уезжали в репозиторий случайно.
_*.html
*.bak
*.orig
*.rej
*.log
*.tmp

# ── Архивы ──
*.zip
*.7z
*.rar
